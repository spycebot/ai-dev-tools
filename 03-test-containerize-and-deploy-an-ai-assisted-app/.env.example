# Card Catalog — Docker Compose settings. Copy to .env (git-ignored) and fill in.
#
# Generate both AUTH_* values with:
#   cd backend && uv run python scripts/set_password.py
#
# Wrap AUTH_PASSWORD_HASH in SINGLE quotes: a bcrypt hash is full of `$`, and
# Compose would otherwise try to expand `$2b`, `$12`, ... as variables.
AUTH_PASSWORD_HASH='$2b$12$replace-me'
AUTH_SECRET_KEY=replace-me

# Local Postgres password (only reachable inside the compose network).
POSTGRES_PASSWORD=card_catalog

# Optional overrides
# AUTH_COOKIE_SECURE=false   # true once served over HTTPS
# APP_BIND=127.0.0.1         # 0.0.0.0 to listen on all interfaces
# APP_PORT=8000
