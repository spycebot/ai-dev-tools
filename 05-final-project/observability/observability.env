# Copied to /srv/card-catalog/observability.env by obs.sh up, and removed by
# obs.sh down. docker-compose.server.yml loads it into the prod and staging
# containers when it exists (env_file, required: false). No secrets here.
FASTAPI_OTEL_AUTO_CONFIGURE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=10000
