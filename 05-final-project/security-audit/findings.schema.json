{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card-catalog/security-audit/findings.schema.json",
  "title": "Card Catalog security audit run",
  "description": "One audit run: what was scanned, by which tools and reviewers, and the human disposition of every finding. Scanner output is kept raw next to it in the same runs/<id>/ folder.",
  "type": "object",
  "required": ["run_id", "date", "commit", "scope", "tools", "findings"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "date": { "type": "string", "format": "date" },
    "commit": { "type": "string", "description": "Commit the scan ran against (short or full SHA)." },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "output"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "examples": ["semgrep 1.180.0", "pip-audit 2.10.1", "claude-opus-5-5"] },
          "kind": { "enum": ["deterministic", "dependency", "model-review", "manual-test"] },
          "config": { "type": "string" },
          "output": { "type": "string", "description": "File in this run folder holding the raw output, or 'inline' for model review recorded in findings." }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "rule", "title", "severity", "locations", "evidence", "disposition", "rationale", "decided_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{2}$" },
          "source": { "enum": ["semgrep", "pip-audit", "osv", "model-review", "manual-test"] },
          "rule": { "type": "string", "description": "Scanner rule or advisory ID; for model review, a short slug." },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"], "description": "Severity in this app's context after triage, not the scanner's default." },
          "scanner_severity": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "locations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "evidence": { "type": "string", "description": "What was checked to confirm or reject the finding." },
          "disposition": { "enum": ["fixed", "false-positive", "accepted-risk", "deferred"] },
          "rationale": { "type": "string" },
          "fix": { "type": "string", "description": "What changed, when disposition is fixed." },
          "decided_by": { "type": "string", "description": "Who made the call: 'proposed: <model>' until a human confirms, then the human's role." }
        }
      }
    }
  }
}
