# Caddy obtains and renews Let's Encrypt certificates for both names
# automatically, redirects HTTP to HTTPS, and forwards to the app containers
# over the compose network (which is why the app sets AUTH_COOKIE_SECURE=true).

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Audit F08. The board can't be framed (clickjacking), and the page
		# may only run its own scripts. React escapes output and there are no
		# eval or innerHTML sinks, so this is a second line of defence. Google
		# Fonts is the only third party (index.html). Inline style attributes
		# aren't needed: React and dnd-kit set styles through the DOM.
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# Content-Security-Policy, one per path set. The matchers must not
	# overlap: Caddy runs every header directive that matches, and with a
	# general and an override policy, the general one overwrote the override.
	# FastAPI's API docs load Swagger UI / ReDoc from jsdelivr and start
	# them with an inline script, so they get a looser policy of their own.
	# They're static pages with no user content.
	@apidocs path /docs /docs/* /redoc
	@app not path /docs /docs/* /redoc
	header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header @apidocs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://fastapi.tiangolo.com https://cdn.redoc.ly; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
}

cards.terzotech.net {
	import common
	reverse_proxy prod:8000
}

staging.cards.terzotech.net {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy staging:8000
}
