# Card Catalog backend — environment variables.
# Copy this file to .env (already git-ignored) and fill in real values.
#
# AUTH_PASSWORD_HASH and AUTH_SECRET_KEY are required — the app refuses to
# start without them (this is a password-gated app by design). Generate both
# with:
#   uv run python scripts/set_password.py

# bcrypt hash of the single shared password. Never put the plaintext
# password here — only the hash the script above prints.
AUTH_PASSWORD_HASH=

# Signs and verifies session cookies. Keep it stable across restarts
# (changing it logs everyone out) and secret (anyone who has it can forge a
# valid session cookie without knowing the password).
AUTH_SECRET_KEY=

# Set to "false" only for local HTTP development without TLS — the session
# cookie otherwise requires HTTPS (as it should once this is public).
AUTH_COOKIE_SECURE=true

# Comma-separated origins allowed to make credentialed requests. Only
# matters if the frontend is ever served from a different origin than the
# backend; same-origin deployments (Vite's dev proxy, or nginx in prod)
# don't depend on this at all.
CORS_ORIGINS=http://localhost:5173

# See ../README.md's "Database" section for DATABASE_URL.
